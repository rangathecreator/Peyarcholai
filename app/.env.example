# OmniRoute AI Gateway (Primary AI Model Source)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your-omniroute-key
OMNIROUTE_DEFAULT_MODEL=auto/best-free
OMNIROUTE_REASONING_MODEL=oc/deepseek-r1

# Dedicated Supabase / Neon PostgreSQL (Optional - falls back to bundled JSON + local store if empty)
DATABASE_URL=

# Feature Flags (Per Product Owner Decisions)
NEXT_PUBLIC_ENABLE_ADS=true
NEXT_PUBLIC_ENABLE_SUBSCRIPTION_PAYWALL=false
NEXT_PUBLIC_SITE_URL=https://names.donorconnect.in

